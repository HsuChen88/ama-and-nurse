# Required. Generate a long random value; never commit the real token.
INFERENCE_API_TOKEN=replace-with-a-random-token

# auto selects CUDA when CTranslate2 can see a GPU, otherwise CPU.
INFERENCE_DEVICE=auto
# Leave empty for cpu=int8 or cuda=float16.
INFERENCE_COMPUTE_TYPE=

ASR_NAN_MODEL=weemed/Breeze-ASR-26-ct2
ASR_ID_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo

# Optional comma-separated eager load list: nan-TW,id
INFERENCE_PRELOAD=
# Maximum waiting requests per model, in addition to its active inference.
INFERENCE_MAX_QUEUE=4
