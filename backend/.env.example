ASR_NAN_PROVIDER=mock
ASR_ID_PROVIDER=mock
TRANSLATE_PROVIDER=mock
TTS_ID_PROVIDER=mock
TTS_NAN_PROVIDER=mock

# Required when either ASR provider is remote.
INFERENCE_BASE_URL=http://localhost:8001
INFERENCE_API_TOKEN=
INFERENCE_CF_ACCESS_CLIENT_ID=
INFERENCE_CF_ACCESS_CLIENT_SECRET=
INFERENCE_TIMEOUT_SECONDS=120

# Required by the corresponding Google provider.
GOOGLE_TRANSLATE_CREDENTIALS=~/.config/ama-and-nurse/gcp-translation-sa.json
GOOGLE_TTS_CREDENTIALS=~/.config/ama-and-nurse/gcp-tts-sa.json
TTS_ID_VOICE=id-ID-Chirp3-HD-Pulcherrima
TTS_ID_SPEAKING_RATE=0.9

AUDIO_TTL_SECONDS=3600
CORS_ORIGINS=http://localhost:5173
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
