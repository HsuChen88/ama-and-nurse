{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ama-translator",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "routes": [
    {
      "pattern": "app.ama-ama.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/join/*"]
  },
  "kv_namespaces": [
    {
      "binding": "INVITES",
      "id": "d238a10a0fc14a77bad394db78ee1268"
    }
  ],
  "d1_databases": [
    {
      "binding": "CACHE_DB",
      "database_name": "ama-translator-cache",
      "database_id": "REPLACE_WITH_CACHE_DB_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "ama-translator-audio"
    }
  ],
  "vars": {
    "INFERENCE_BASE_URL": "https://inference.ama-ama.com",
    "TTS_ID_VOICE": "id-ID-Chirp3-HD-Pulcherrima",
    "TTS_ID_SPEAKING_RATE": "0.9",
    "INFERENCE_TIMEOUT_MS": "30000",
    "INFERENCE_TTS_TIMEOUT_MS": "30000",
    "GOOGLE_TIMEOUT_MS": "15000",
    "TAIGI_TRANSLATE_TIMEOUT_MS": "5000",
    "TAIGI_TTS_TIMEOUT_MS": "8000",
    "TAIGI_TTS_MODEL": "model7",
    "TAIGI_TTS_VOICE": "normal_f2",
    "TAIGI_TTS_SPEED": "1.0"
  }
}
