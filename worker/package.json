{
  "name": "ama-translator-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "he": "^1.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "scripts": {
    "build": "pnpm --dir ../frontend build && pnpm typecheck",
    "dev": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "cache-stats": "tsx scripts/cache-stats.ts",
    "invite": "tsx scripts/invite.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@types/he": "^1.2.3",
    "@types/node": "^22.15.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@eslint/js": "^9.37.0",
    "eslint": "^9.37.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "tsx": "^4.20.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.0"
  },
  "packageManager": "pnpm@11.22.0"
}
