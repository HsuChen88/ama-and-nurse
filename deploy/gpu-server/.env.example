# GPU server only. Do not commit real values.
INFERENCE_API_TOKEN=replace-with-a-random-token
CLOUDFLARE_TUNNEL_TOKEN=replace-with-the-tunnel-token

INFERENCE_COMPUTE_TYPE=float16
INFERENCE_PRELOAD=nan-TW,id
INFERENCE_MAX_QUEUE=4
# Keep 1 during normal operation. Temporarily set 0 only while downloading models.
HF_HUB_OFFLINE=1
ASR_NAN_MODEL=weemed/Breeze-ASR-26-ct2
ASR_ID_MODEL=mobiuslabsgmbh/faster-whisper-large-v3-turbo

# Pre-created Docker network that the host firewall allows outbound.
DOCKER_EGRESS_NETWORK=wasn-egress
